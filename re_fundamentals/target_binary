(function() {
  var holbertonDomains = ['@holbertonschool.com', '@holberton.us', '@holbertonstudents.com'];
  var emailField = document.getElementById('session-email-field');
  var warningDiv = document.getElementById('holberton-email-warning');

  if (emailField && warningDiv) {
    function checkEmail() {
      var value = (emailField.value || '').toLowerCase().trim();
      var isHolberton = holbertonDomains.some(function(domain) {
        return value.endsWith(domain) || value.includes(domain);
      });
      warningDiv.style.display = isHolberton ? 'block' : 'none';
    }

    emailField.addEventListener('input', checkEmail);
    emailField.addEventListener('change', checkEmail);
  }
})();
</script>

